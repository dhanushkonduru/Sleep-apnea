# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL (if using local database instead of Supabase)
DATABASE_URL=postgresql://sleepapnea:sleepapnea123@localhost:5432/sleepapnea
POSTGRES_DB=sleepapnea
POSTGRES_USER=sleepapnea
POSTGRES_PASSWORD=sleepapnea123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# MinIO/S3 configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=audio-files
MINIO_USE_SSL=false

# AWS S3 (for production)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sleep-apnea-audio-files

# =============================================================================
# ML MODEL CONFIGURATION
# =============================================================================
# Model settings
MODEL_PATH=/app/models/sleep_apnea_model.pth
MODEL_VERSION=demo-v1.0
CONFIDENCE_THRESHOLD=0.5
MIN_EVENT_DURATION=2.0

# Audio processing settings
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION=300
AUDIO_MIN_DURATION=10
AUDIO_FORMATS=wav,mp3,m4a

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT settings
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS settings
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Email settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sleepapnea.ai
SMTP_FROM_NAME=Sleep Apnea AI

# Twilio SMS settings
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin123

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Development mode
DEBUG=true
RELOAD=true
HOT_RELOAD=true

# Testing
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/sleepapnea_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Production settings (uncomment for production)
# DEBUG=false
# RELOAD=false
# HOT_RELOAD=false
# LOG_LEVEL=WARNING

# SSL/TLS
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_REAL_TIME_ANALYSIS=true
ENABLE_NOTIFICATIONS=true
ENABLE_EXPORT=true
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Third-party API keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Medical data APIs
HEALTH_DATA_API_KEY=your-health-data-api-key
CLINICAL_TRIALS_API_KEY=your-clinical-trials-api-key

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
